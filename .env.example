# Optional: override the football API origin (default is FotMob).
# Local dev uses the Vite proxy at /football-api instead.
VITE_FOOTBALL_API_BASE=

# Optional licensed live-score keys (unused while FotMob is the source).
FOOTBALL_API_KEY=
FOOTBALL_DATA_API_KEY=

# Production base path for GitHub Pages
VITE_BASE=/hbs-national-team-match-center/

# Development-only overlay. Production builds ignore .env.development.
VITE_USE_DEMO_DATA=false
